<div class="fated-sheet-body item-sheet-body">
  <header class="fated-sheet-header compact">
    <img class="portrait" src="{{item.img}}" alt="{{item.name}}">
    <div class="identity">
      <label>Name</label>
      <input type="text" name="name" value="{{item.name}}" {{disabled (not editable)}}>
      <span class="actor-type">{{item.type}}</span>
    </div>
  </header>

  {{#if hasLoad}}
    <section class="panel">
      <label>Load <input type="number" name="system.load" value="{{system.load}}" min="0" {{disabled (not editable)}}></label>
    </section>
  {{/if}}

  {{#if isWeapon}}
    <section class="panel">
      <h2>Weapon</h2>
      <div class="stat-grid two">
        <label>Proficiency <input type="text" name="system.proficiency" value="{{system.proficiency}}" {{disabled (not editable)}}></label>
        <label>Damage <input type="number" name="system.damage" value="{{system.damage}}" min="0" {{disabled (not editable)}}></label>
      </div>
    </section>
  {{/if}}

  {{#if isProficiency}}
    <section class="panel">
      <label>Proficiency Key <input type="text" name="system.key" value="{{system.key}}" {{disabled (not editable)}}></label>
    </section>
  {{/if}}

  {{> "systems/fated/templates/item/action-editor.hbs"}}

  <section class="panel">
    <h2>Description</h2>
    <textarea name="system.description" rows="10" {{disabled (not editable)}}>{{system.description}}</textarea>
  </section>
</div>
