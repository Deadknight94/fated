<section class="panel">
  <h2>{{localize "FATED.Damage.Against"}} {{targetName}}</h2>
  <p>{{localize "FATED.Damage.InputHint"}}</p>
  <label>{{localize "FATED.Damage.AttackSource"}} <select data-damage-field="attack"><option value="">{{localize "FATED.Damage.Manual"}}</option>{{#each attacks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  <label>{{localize "FATED.Damage.PhysicalSuccesses"}} <input type="number" min="0" step="1" data-damage-field="successes" value="{{values.successes}}"></label>
  <label>{{localize "FATED.Damage.ManualInput"}} <input type="number" min="0" step="any" data-damage-field="finalDamage" value="{{values.finalDamage}}"></label>
  <p>{{localize "FATED.Damage.ManualHint"}}</p>
  <button type="button" data-action="preview">{{localize "FATED.Damage.Preview"}}</button>
  {{#if message}}<p role="status">{{message}}</p>{{/if}}
  {{#if result}}
  <dl>
    {{#unless result.manual}}<div><dt>{{localize "FATED.Damage.Product"}}</dt><dd>{{result.successes}} × {{result.damagePerSuccess}} = {{result.baseTotalDamage}}</dd></div>{{/unless}}
    {{#each result.finalDamageModifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
    <div><dt>{{localize "FATED.Damage.FinalMinimum"}}</dt><dd>{{result.finalDamage}}</dd></div>
    <div><dt>{{localize "FATED.Damage.DefenseBase"}}</dt><dd>{{result.defense.body}} + {{result.defense.mind}} = {{result.defense.base}}</dd></div>
    {{#each result.defense.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
    <div><dt>{{localize "FATED.Combat.Raw"}}</dt><dd>{{result.defense.raw}}</dd></div>
    <div><dt>{{localize "FATED.Damage.DefenseMinimum"}}</dt><dd>{{result.targetDefense}}</dd></div>
    <div><dt>{{localize "FATED.Damage.WoundsInflicted"}}</dt><dd>{{result.wounds}}</dd></div>
    <div><dt>{{localize "FATED.Damage.ResultSeverity"}}</dt><dd>{{result.resultingWoundSeverity}}</dd></div>
  </dl>
  {{/if}}
  <button type="button" data-action="apply" {{disabled (not canApply)}}>{{localize "FATED.Damage.Apply"}}</button>
</section>
