{{#with healthState as |health|}}
<section class="panel health-state" aria-label="{{localize "FATED.Health.HealthAndConditions"}}">
  <h2>{{localize "FATED.Health.Health"}}</h2>
  <p><strong>{{localize "FATED.Health.Wounds"}}: {{health.woundLabel}}</strong> · {{localize "FATED.Health.Severity"}} {{health.severity}}</p>
  <div class="health-controls">
    <button
      type="button"
      data-action="health"
      data-health-operation="wound"
      data-delta="-1"
      aria-label="{{localize "FATED.Health.DecreaseWoundSeverity"}}"
      {{disabled (or (not @root.editable) (not health.canDecreaseWound))}}
    >
      {{localize "FATED.Health.Decrease"}} 1 {{localize "FATED.Health.Wound"}}
    </button>

    <button
      type="button"
      data-action="health"
      data-health-operation="wound"
      data-delta="1"
      aria-label="{{localize "FATED.Health.IncreaseWoundSeverity"}}"
      {{disabled (or (not @root.editable) (not health.canIncreaseWound))}}
    >
      {{localize "FATED.Health.Increase"}} 1 {{localize "FATED.Health.Wound"}}
  </button>
</div>
  {{#if health.conditions.length}}<ul class="health-conditions">{{#each health.conditions}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>{{localize "FATED.Health.NoResourceConditions"}}</p>{{/if}}
  {{#if health.deathsDoor}}
    <p><strong>{{localize "FATED.Health.DeathsDoor"}} · {{#if health.stabilized}}{{localize "FATED.Health.Stabilized"}}{{else}}{{localize "FATED.Health.Unstabilized"}}{{/if}} · {{localize "FATED.Health.Incapacitated"}}</strong></p>
    <button type="button" data-action="health" data-health-operation="stabilize" {{disabled (not @root.editable)}}>{{#if health.stabilized}}{{localize "FATED.Health.MarkUnstabilized"}}{{else}}{{localize "FATED.Health.MarkStabilized"}}{{/if}}</button>
    {{#if health.stabilized}}<p>{{localize "FATED.Health.StabilizationStops"}}</p>
    {{else}}<p>{{localize "FATED.Health.UnstabilizedLose"}}</p>{{/if}}
  {{/if}}
  {{#if health.broken}}<p><strong>{{localize "FATED.Health.Broken"}}:</strong> {{localize "FATED.Health.IncapacitatedUntil"}}. {{localize "FATED.Health.BrokenCausesNo"}}. {{localize "FATED.Health.LosePower"}}. {{localize "FATED.Health.ContinuouslyBroken"}}. {{localize "FATED.Health.ApplyRulesManually"}}.</p>{{/if}}
  {{#if health.dead}}<p><strong>{{localize "FATED.Health.Dead"}}.</strong> {{localize "FATED.Health.ReducingWounds"}}</p>{{/if}}
  {{#if health.isGM}}<details><summary>{{localize "FATED.Health.GMAdministrativeCorrection"}}</summary><p>{{localize "FATED.Health.CorrectRecordedDeath"}}. {{localize "FATED.Health.NotHealingOrResurrection"}}. {{localize "FATED.Health.Severity4MeansDead"}}. {{localize "FATED.Health.LowerSeverityBeforeClearing"}}.</p><button type="button" data-action="health" data-health-operation="correct-death" {{disabled (not @root.editable)}}>{{#if health.recordedDead}}{{localize "FATED.Health.ClearRecordedDeath"}}{{else}}{{localize "FATED.Health.RecordDeath"}}{{/if}}</button></details>{{/if}}
</section>
{{/with}}
