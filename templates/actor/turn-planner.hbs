<section class="turn-planner" aria-label="Turn" data-declaration-revision="{{planner.revision}}">
  <h2>Turn · {{#if planner.locked}}Locked{{else}}Editing{{/if}}</h2>
  {{#if planner.locked}}
    <p class="turn-stance">{{planner.stanceLabel}}</p>
    <p class="mobile-note">Declared values are frozen. Check off entries as you resolve them at the table.</p>
  {{else}}
    <h3>1. Choose stance</h3>
    <div class="turn-stance-buttons" role="group" aria-label="Stance">
      {{#each planner.stances}}
      <button type="button" data-action="planner" data-operation="stance" data-stance="{{value}}" aria-pressed="{{selected}}" {{disabled (not @root.editable)}}>{{label}}</button>
      {{/each}}
    </div>
    <h3>2. Declare your sequence</h3>
  {{/if}}
  <p class="turn-counts">Main Actions: {{planner.mainCount}} / 3 · Multi-Action Threshold: {{#if (eq planner.multiActionPenalty null)}}Unspecified{{else}}+{{planner.multiActionPenalty}}{{/if}}</p>
  {{#if planner.issues.length}}
  <div class="turn-issues" role="status">
    <strong>Cannot lock yet</strong>
    <ul>{{#each planner.issues}}<li>{{#if incomplete}}Incomplete: {{/if}}{{message}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  <ol class="turn-sequence">
    {{#each planner.entries as |entry|}}
    <li class="turn-entry {{#if completed}}turn-completed{{/if}}" data-entry-id="{{id}}">
      <h3><span class="turn-number">{{number}}.</span> {{#if movement}}Move{{else}}{{name}}{{/if}}</h3>
      {{#if movement}}
        <p class="turn-instruction">Up to {{#if @root.planner.locked}}{{movementHexes}}{{else}}3{{/if}} hexes</p>
        <p class="mobile-note">One continuous Movement segment.</p>
      {{else}}
        <p class="mobile-source">{{classificationLabel}} Action · {{action.source.itemName}}</p>
        {{#if requiresRoll}}
          <p class="turn-instruction">Roll {{dice.total}} Success Dice</p>
          <p class="turn-instruction">Success Threshold {{threshold.total}}</p>
        {{else}}
          <p>{{#if noRoll}}No roll required{{else}}Roll requirement unspecified{{/if}}</p>
        {{/if}}
        {{#if action.effect}}<p class="mobile-rules"><strong>Damage / effect:</strong> {{action.effect}}</p>{{/if}}
        {{#if action.rules}}<p class="mobile-rules">{{action.rules}}</p>{{/if}}
        <details class="mobile-breakdown" data-planner-detail="{{id}}">
          <summary>Action &amp; modifier details</summary>
          <p>Range: {{rangeLabel}}</p>
          {{#if requiresRoll}}
          <h4>Success Dice · {{diceSourceLabel}}</h4>
          <dl><div><dt>Base Success Dice</dt><dd>{{dice.base}}</dd></div>
            {{#each dice.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
            <div><dt>Final Success Dice</dt><dd>{{dice.total}}</dd></div></dl>
          <h4>Success Threshold</h4>
          <dl><div><dt>Base Threshold</dt><dd>{{threshold.base}}</dd></div>
            {{#each threshold.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
            <div><dt>Final Threshold</dt><dd>{{threshold.total}}</dd></div></dl>
          {{/if}}
        </details>
      {{/if}}
      {{#if @root.planner.locked}}
        <button type="button" data-action="planner" data-operation="complete" data-entry-id="{{id}}" aria-pressed="{{completed}}" {{disabled (not @root.editable)}}>{{#if completed}}Done · undo check{{else}}Mark done{{/if}}</button>
      {{else}}
        <div class="turn-entry-controls">
          <button type="button" data-action="planner" data-operation="move" data-entry-id="{{id}}" data-direction="-1" aria-label="Move entry {{number}} up" {{disabled (or (not canMoveUp) (not @root.editable))}}>↑ Up</button>
          <button type="button" data-action="planner" data-operation="move" data-entry-id="{{id}}" data-direction="1" aria-label="Move entry {{number}} down" {{disabled (or (not canMoveDown) (not @root.editable))}}>↓ Down</button>
          <button type="button" data-action="planner" data-operation="remove" data-entry-id="{{id}}" aria-label="Remove entry {{number}}" {{disabled (not @root.editable)}}>Remove</button>
        </div>
      {{/if}}
    </li>
    {{else}}<li class="mobile-empty">No entries declared.</li>{{/each}}
  </ol>
  {{#if planner.locked}}
    <button type="button" class="turn-primary" data-action="planner" data-operation="clear" {{disabled (not editable)}}>End declaration · prepare next turn</button>
  {{else}}
    <button type="button" data-action="planner" data-operation="add" data-kind="movement" {{disabled (or (not planner.canAddMovement) (not editable))}}>Add Movement · up to 3 hexes</button>
    {{#if planner.stanceChosen}}
    <details class="turn-picker" data-planner-detail="picker">
      <summary>Add an Action</summary>
      <p class="mobile-note">Owned, enabled Actions. Incomplete or disallowed choices are flagged in the sequence.</p>
      {{#each actions}}
      <button type="button" data-action="planner" data-operation="add" data-kind="action" data-item-id="{{source.itemId}}" data-action-id="{{id}}" {{disabled (or additionIssue (not @root.editable))}}><strong>{{name}}</strong><span>{{source.itemName}} · {{classificationLabel}} · {{rollRequirementLabel}}</span>{{#if additionIssue}}<span>{{additionIssue}}</span>{{/if}}</button>
      {{else}}<p>No enabled Actions. Configure your owned Items first.</p>{{/each}}
    </details>
    {{/if}}
    <button type="button" class="turn-primary" data-action="planner" data-operation="lock" {{disabled (or (not planner.canLock) (not editable))}}>Lock Declaration</button>
  {{/if}}
</section>
