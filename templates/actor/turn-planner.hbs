<section class="turn-planner" aria-label="{{localize "FATED.Common.Turn"}}" data-declaration-revision="{{planner.revision}}">
  <h2>{{localize "FATED.Common.Turn"}} · {{#if planner.locked}}{{localize "FATED.Planner.Locked"}}{{else}}{{localize "FATED.Planner.Editing"}}{{/if}}</h2>
  {{#if planner.locked}}
    <p class="turn-stance">{{planner.stanceLabel}}</p>
    <p class="mobile-note">{{localize "FATED.Planner.FrozenHint"}}</p>
  {{else}}
    <h3>{{localize "FATED.Planner.ChooseStance"}}</h3>
    <div class="turn-stance-buttons" role="group" aria-label="{{localize "FATED.Common.Stance"}}">
      {{#each planner.stances}}
      <button type="button" data-action="planner" data-operation="stance" data-stance="{{value}}" aria-pressed="{{selected}}" {{disabled (not @root.editable)}}>{{label}}</button>
      {{/each}}
    </div>
    <h3>{{localize "FATED.Planner.DeclareSequence"}}</h3>
  {{/if}}
  <p class="turn-counts">{{localize "FATED.Planner.MainActions"}}: {{planner.mainCount}} / 3 · {{localize "FATED.Planner.MultiThreshold"}}: {{#if (eq planner.multiActionPenalty null)}}{{localize "FATED.Common.Unspecified"}}{{else}}+{{planner.multiActionPenalty}}{{/if}}</p>
  {{#if planner.issues.length}}
  <div class="turn-issues" role="status">
    <strong>{{localize "FATED.Planner.CannotLock"}}</strong>
    <ul>{{#each planner.issues}}<li>{{#if incomplete}}{{localize "FATED.Planner.Incomplete"}}: {{/if}}{{message}}</li>{{/each}}</ul>
  </div>
  {{/if}}
  <ol class="turn-sequence">
    {{#each planner.entries as |entry|}}
    <li class="turn-entry {{#if completed}}turn-completed{{/if}}" data-entry-id="{{id}}">
      <h3><span class="turn-number">{{number}}.</span> {{#if movement}}{{localize "FATED.Planner.Move"}}{{else}}{{name}}{{/if}}</h3>
      {{#if movement}}
        <p class="turn-instruction">{{localize "FATED.Planner.UpTo"}} {{#if @root.planner.locked}}{{movementHexes}}{{else}}3{{/if}} {{localize "FATED.Action.Hexes"}}</p>
        <p class="mobile-note">{{localize "FATED.Planner.ContinuousMovement"}}</p>
      {{else}}
        <p class="mobile-source">{{classificationLabel}} · {{action.source.itemName}}</p>
        {{#if requiresRoll}}
          <p class="turn-instruction">{{localize "FATED.Common.Roll"}} {{dice.total}} {{localize "FATED.Roll.SuccessDice"}}</p>
          <p class="turn-instruction">{{localize "FATED.Roll.SuccessThreshold"}} {{threshold.total}}</p>
        {{else}}
          <p>{{#if noRoll}}{{localize "FATED.Action.NoRollRequired"}}{{else}}{{localize "FATED.Action.RollUnspecified"}}{{/if}}</p>
        {{/if}}
        {{#if action.effect}}<p class="mobile-rules"><strong>{{localize "FATED.Action.DamageEffect"}}:</strong> {{action.effect}}</p>{{/if}}
        {{#if action.rules}}<p class="mobile-rules">{{action.rules}}</p>{{/if}}
        <details class="mobile-breakdown" data-planner-detail="{{id}}">
          <summary>{{localize "FATED.Planner.Details"}}</summary>
          <p>{{localize "FATED.Action.Range"}}: {{rangeLabel}}</p>
          {{#if requiresRoll}}
          <h4>{{localize "FATED.Roll.SuccessDice"}} · {{diceSourceLabel}}</h4>
          <dl><div><dt>{{localize "FATED.Action.BaseDice"}}</dt><dd>{{dice.base}}</dd></div>
            {{#each dice.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
            <div><dt>{{localize "FATED.Action.FinalDice"}}</dt><dd>{{dice.total}}</dd></div></dl>
          <h4>{{localize "FATED.Roll.SuccessThreshold"}}</h4>
          <dl><div><dt>{{localize "FATED.Action.BaseThreshold"}}</dt><dd>{{threshold.base}}</dd></div>
            {{#each threshold.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
            <div><dt>{{localize "FATED.Action.FinalThreshold"}}</dt><dd>{{threshold.total}}</dd></div></dl>
          {{/if}}
        </details>
      {{/if}}
      {{#if @root.planner.locked}}
        <button type="button" data-action="planner" data-operation="complete" data-entry-id="{{id}}" aria-pressed="{{completed}}" {{disabled (not @root.editable)}}>{{#if completed}}{{localize "FATED.Planner.UndoDone"}}{{else}}{{localize "FATED.Planner.MarkDone"}}{{/if}}</button>
      {{else}}
        <div class="turn-entry-controls">
          <button type="button" data-action="planner" data-operation="move" data-entry-id="{{id}}" data-direction="-1" aria-label="{{localize "FATED.Planner.MoveUp" number=number}}" {{disabled (or (not canMoveUp) (not @root.editable))}}>{{localize "FATED.Planner.Up"}}</button>
          <button type="button" data-action="planner" data-operation="move" data-entry-id="{{id}}" data-direction="1" aria-label="{{localize "FATED.Planner.MoveDown" number=number}}" {{disabled (or (not canMoveDown) (not @root.editable))}}>{{localize "FATED.Planner.Down"}}</button>
          <button type="button" data-action="planner" data-operation="remove" data-entry-id="{{id}}" aria-label="{{localize "FATED.Planner.RemoveEntry" number=number}}" {{disabled (not @root.editable)}}>{{localize "FATED.Common.Remove"}}</button>
        </div>
      {{/if}}
    </li>
    {{else}}<li class="mobile-empty">{{localize "FATED.Planner.NoEntries"}}</li>{{/each}}
  </ol>
  {{#if planner.locked}}
    <button type="button" class="turn-primary" data-action="planner" data-operation="clear" {{disabled (not editable)}}>{{localize "FATED.Planner.End"}}</button>
  {{else}}
    <button type="button" data-action="planner" data-operation="add" data-kind="movement" {{disabled (or (not planner.canAddMovement) (not editable))}}>{{localize "FATED.Planner.AddMovement"}}</button>
    {{#if planner.stanceChosen}}
    <details class="turn-picker" data-planner-detail="picker">
      <summary>{{localize "FATED.Item.AddAction"}}</summary>
      <p class="mobile-note">{{localize "FATED.Planner.PickerHint"}}</p>
      {{#each actions}}
      <button type="button" data-action="planner" data-operation="add" data-kind="action" data-item-id="{{source.itemId}}" data-action-id="{{id}}" {{disabled (or additionIssue (not @root.editable))}}><strong>{{name}}</strong><span>{{source.itemName}} · {{classificationLabel}} · {{rollRequirementLabel}}</span>{{#if additionIssue}}<span>{{additionIssue}}</span>{{/if}}</button>
      {{else}}<p>{{localize "FATED.Planner.NoActions"}}</p>{{/each}}
    </details>
    {{/if}}
    <button type="button" class="turn-primary" data-action="planner" data-operation="lock" {{disabled (or (not planner.canLock) (not editable))}}>{{localize "FATED.Planner.Lock"}}</button>
  {{/if}}
</section>
