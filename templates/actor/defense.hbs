<section class="panel" aria-label="Defense">
  <h2>Defense · {{defense.total}}</h2>
  <details><summary>Defense breakdown</summary><p>Body {{defense.body}} + Mind {{defense.mind}} = {{defense.base}}</p>
    {{#each defense.modifiers}}<p>{{label}}: {{value}}</p>{{/each}}
    <p>Raw Defense: {{defense.raw}} · Effective Defense: {{defense.total}} (minimum 1)</p>
  </details>
</section>
