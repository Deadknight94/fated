<div class="fated-sheet-body">
  <nav class="fated-section-nav" aria-label="{{localize "FATED.Sheet.Sections"}}">
    <button type="button" data-action="selectSection" data-section="character" aria-label="{{localize "FATED.Common.Character"}}"{{#if (or turnSection actionsSection itemsSection notesSection)}}{{else}} aria-current="page"{{/if}}>{{localize "FATED.Common.Character"}}</button>
    <button type="button" data-action="selectSection" data-section="turn" aria-label="{{localize "FATED.Common.Turn"}}"{{#if turnSection}} aria-current="page"{{/if}}>{{localize "FATED.Common.Turn"}}</button>
    <button type="button" data-action="selectSection" data-section="actions" aria-label="{{localize "FATED.Common.Actions"}}"{{#if actionsSection}} aria-current="page"{{/if}}>{{localize "FATED.Common.Actions"}}</button>
    <button type="button" data-action="selectSection" data-section="items" aria-label="{{localize "FATED.Sheet.Items"}}"{{#if itemsSection}} aria-current="page"{{/if}}>{{localize "FATED.Sheet.Items"}}</button>
    <button type="button" data-action="selectSection" data-section="notes" aria-label="{{localize "FATED.Sheet.Biography"}}"{{#if notesSection}} aria-current="page"{{/if}}>{{localize "FATED.Sheet.Biography"}}</button>
  </nav>

  {{#if itemsSection}}
  <section class="panel inventory">
    <h2>{{localize "FATED.Sheet.Items"}}</h2>
    {{#if items.length}}
      <ul class="item-list">
        {{#each items as |item|}}
          <li class="item-row draggable" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="">
            <button type="button" class="fated-item-open" data-action="openItem" data-item-id="{{item.id}}">{{localize "FATED.Common.Open"}}: {{item.name}}</button>
            <small>{{item.typeLabel}}</small>
            {{#if item.equipmentState}}<button type="button" data-action="toggleEquipment" data-item-id="{{item.id}}" aria-pressed="{{item.equipped}}" {{disabled (not item.editable)}}>{{item.stateLabel}}: {{#if item.equipped}}{{localize "FATED.Common.Yes"}}{{else}}{{localize "FATED.Common.No"}}{{/if}}</button>{{/if}}
            <button type="button" data-action="removeItem" data-item-id="{{item.id}}" {{disabled (not @root.editable)}}>{{localize "FATED.Sheet.Remove"}}</button>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="muted">{{localize "FATED.Sheet.NoItems"}}</p>
    {{/if}}
  </section>
  {{else if notesSection}}
  <section class="panel biography">
    <h2>{{localize "FATED.Sheet.Biography"}}</h2>
    <textarea name="system.biography" rows="8" {{disabled (not editable)}}>{{system.biography}}</textarea>
  </section>
  {{else if turnSection}}
  {{> "systems/fated/templates/actor/turn-planner.hbs"}}
  {{else if actionsSection}}
  <section class="fated-actions" aria-label="{{localize "FATED.Common.Actions"}}">
    <h2>{{localize "FATED.Common.Actions"}} ({{actions.length}})</h2>
    <p class="muted">{{localize "FATED.Mobile.ActionHint"}}</p>
    <div class="fated-action-list">
      {{#each actions as |action|}}
      <article class="fated-action-card">
        <header>
          <div><small>{{action.classificationLabel}}</small><h3>{{action.name}}</h3><p>{{action.source.itemName}}</p></div>
          <button type="button" data-action="openItem" data-item-id="{{action.source.itemId}}">{{localize "FATED.Common.Open"}}: {{action.source.itemName}}</button>
        </header>
        <p>{{action.rollRequirementLabel}}</p>
        {{#if action.thresholdReviewIssue}}<p class="fated-action-warning" role="alert">{{action.thresholdReviewIssue}}</p>{{/if}}
        <dl class="fated-action-facts">
          <div class="fated-action-total"><dt>{{localize "FATED.Roll.SuccessDice"}}</dt><dd>{{action.dice.total}}</dd></div>
          <div class="fated-action-total"><dt>{{localize "FATED.Roll.SuccessThreshold"}}</dt><dd>{{action.threshold.total}}</dd></div>
          <div><dt>{{localize "FATED.Damage.PerSuccess"}}</dt><dd>{{#if action.hasDamage}}{{action.damagePerSuccess}}{{else}}{{localize "FATED.Common.Unspecified"}}{{/if}}</dd></div>
          <div><dt>{{localize "FATED.Action.Range"}}</dt><dd>{{action.rangeLabel}}</dd></div>
          <div><dt>{{localize "FATED.Action.Use"}}</dt><dd>{{action.attackLabel}}</dd></div>
          <div><dt>{{localize "FATED.Action.AllowedStances"}}</dt><dd>{{action.stanceLabel}}</dd></div>
          <div><dt>{{localize "FATED.Action.MultiEligible"}}</dt><dd>{{action.eligibilityLabel}}</dd></div>
        </dl>
        {{#if action.hasDamage}}{{#each action.damageModifiers}}<p>{{label}}: {{value}} {{localize "FATED.Damage.Final"}}</p>{{/each}}{{/if}}
        {{#if action.effect}}<p class="fated-action-rules"><strong>{{localize "FATED.Action.DamageEffect"}}:</strong> {{action.effect}}</p>{{/if}}
        {{#if action.rules}}<p class="fated-action-rules">{{action.rules}}</p>{{/if}}
        <details class="fated-action-breakdown">
          <summary>{{localize "FATED.Mobile.DiceDetails"}}</summary>
          <div class="fated-action-calculations">
            <div><h4>{{localize "FATED.Roll.SuccessDice"}}</h4><p>{{action.diceSourceLabel}}</p>
              <dl><div><dt>{{localize "FATED.Action.BaseDice"}}</dt><dd>{{action.dice.base}}</dd></div>
              {{#each action.dice.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
              <div><dt>{{localize "FATED.Action.ConfiguredDice"}}</dt><dd>{{action.dice.total}}</dd></div></dl>
            </div>
            <div><h4>{{localize "FATED.Roll.SuccessThreshold"}}</h4>
              <dl><div><dt>{{localize "FATED.Action.BaseThreshold"}}</dt><dd>{{action.threshold.base}}</dd></div>
              {{#each action.threshold.modifiers}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
              <div><dt>{{localize "FATED.Action.FinalThreshold"}}</dt><dd>{{action.threshold.total}}</dd></div></dl>
            </div>
          </div>
        </details>
      </article>
      {{else}}<div class="panel"><h3>{{localize "FATED.Mobile.NoActions"}}</h3><p>{{localize "FATED.Mobile.AddActionHint"}}</p></div>{{/each}}
    </div>
  </section>
  {{else}}
  <header class="fated-sheet-header">
    <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
    <div class="identity">
      <label>{{localize "FATED.Sheet.Name"}}</label>
      <input type="text" name="name" value="{{actor.name}}" {{disabled (not editable)}}>
      <span class="actor-type">Fated</span>
    </div>
  </header>

  <section class="panel">
    <h2>{{localize "FATED.Sheet.PrimaryAttributes"}}</h2>
    <div class="stat-grid three">
      <label>{{localize "FATED.Attribute.Heart"}} <input type="number" name="system.attributes.heart" value="{{system.attributes.heart}}" min="0" {{disabled (not editable)}}></label>
      <label>{{localize "FATED.Attribute.Body"}} <input type="number" name="system.attributes.body" value="{{system.attributes.body}}" min="0" {{disabled (not editable)}}></label>
      <label>{{localize "FATED.Attribute.Mind"}} <input type="number" name="system.attributes.mind" value="{{system.attributes.mind}}" min="0" {{disabled (not editable)}}></label>
    </div>
  </section>

  <section class="panel">
    <h2>{{localize "FATED.Sheet.Skills"}}</h2>

    <div class="skills-grid">
      {{#each skills as |group|}}
        <div class="skill-group">
          <h3>{{group.label}}</h3>

          {{#each group.skills as |skill|}}
            <label>
              {{skill.label}}
              <input
                type="number"
                name="system.skills.{{skill.key}}"
                value="{{skill.value}}"
                min="0"
                step="1"
                {{disabled (not @root.editable)}}
              >
            </label>
          {{/each}}
        </div>
      {{/each}}
    </div>
  </section>

  <section class="panel">
    <h2>{{localize "FATED.Sheet.Resources"}}</h2>
    <div class="resource-grid">
      <div class="fated-resource">
        <label>{{localize "FATED.Resource.Endurance"}}
          <span class="resource-pair">
            <input type="number" name="system.resources.endurance.value" value="{{system.resources.endurance.value}}" min="0" max="{{system.resources.endurance.max}}" {{disabled (not editable)}}>
            <strong>/ {{system.resources.endurance.max}}</strong>
          </span>
        </label>
        <div class="fated-resource-controls"><button type="button" data-action="adjustResource" data-resource="endurance" data-delta="-1" aria-label="{{localize "FATED.Mobile.DecreaseEndurance"}}" {{disabled (not editable)}}>−1</button><button type="button" data-action="adjustResource" data-resource="endurance" data-delta="1" aria-label="{{localize "FATED.Mobile.IncreaseEndurance"}}" {{disabled (not editable)}}>+1</button></div>
      </div>
      <div class="fated-resource">
        <label>{{localize "FATED.Resource.Hope"}}
          <span class="resource-pair">
            <input type="number" name="system.resources.hope.value" value="{{system.resources.hope.value}}" min="-{{system.resources.hope.max}}" max="{{system.resources.hope.max}}" {{disabled (not editable)}}>
            <strong>± {{system.resources.hope.max}}</strong>
          </span>
        </label>
        <div class="fated-resource-controls"><button type="button" data-action="adjustResource" data-resource="hope" data-delta="-1" aria-label="{{localize "FATED.Mobile.DecreaseHope"}}" {{disabled (not editable)}}>−1</button><button type="button" data-action="adjustResource" data-resource="hope" data-delta="1" aria-label="{{localize "FATED.Mobile.IncreaseHope"}}" {{disabled (not editable)}}>+1</button></div>
      </div>
      <div class="fated-resource">
        <label>{{localize "FATED.Resource.Power"}}
          <span class="resource-pair">
            <input type="number" name="system.resources.power" value="{{system.resources.power}}" min="0" max="{{powerMax}}" {{disabled (not editable)}}>
            <strong>/ {{powerMax}}</strong>
          </span>
        </label>
        <div class="fated-resource-controls"><button type="button" data-action="adjustResource" data-resource="power" data-delta="-1" aria-label="{{localize "FATED.Mobile.DecreasePower"}}" {{disabled (not editable)}}>−1</button><button type="button" data-action="adjustResource" data-resource="power" data-delta="1" aria-label="{{localize "FATED.Mobile.IncreasePower"}}" {{disabled (not editable)}}>+1</button></div>
      </div>
      <label>{{localize "FATED.Resource.Load"}} <input type="number" value="{{system.load}}" readonly></label>
    </div>
    <label class="fated-current-stance">{{localize "FATED.Sheet.CurrentStance"}}
      <select name="system.currentStance" {{disabled (not editable)}}>{{#each currentStances}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
  </section>

  <section class="panel">
    <h2>{{localize "FATED.Sheet.Proficiencies"}}</h2>
    <div class="proficiencies-grid">
      {{#if system.proficiencies.length}}
        <ul class="proficiency-list">
          {{#each system.proficiencies as |prof index|}}
            <li class="proficiency-row" data-proficiency-key="{{prof.key}}">
              <details data-proficiency-key="{{prof.key}}">
                <summary>
                  <span class="proficiency-summary-name">{{prof.displayName}}</span>
                  <span class="proficiency-summary-attribute">
                    {{#if (eq prof.attribute "heart")}}{{localize "FATED.Attribute.Heart"}}{{/if}}
                    {{#if (eq prof.attribute "body")}}{{localize "FATED.Attribute.Body"}}{{/if}}
                    {{#if (eq prof.attribute "mind")}}{{localize "FATED.Attribute.Mind"}}{{/if}}
                  </span>
                  <span class="proficiency-summary-level">{{localize "FATED.Sheet.Level"}} {{prof.level}}</span>
                </summary>
                <div class="proficiency-fields">
                  <label>
                    <span>{{localize "FATED.Sheet.Display"}}</span>
                    <input type="text" name="system.proficiencies.{{index}}.displayName" value="{{prof.displayName}}" {{disabled (not @root.editable)}} />
                  </label>
                  <label>
                    <span>{{localize "FATED.Sheet.Key"}} {{#unless @root.canEditProficiencyKeys}}<i class="fas fa-lock proficiency-key-lock" role="img" aria-label="{{localize "FATED.Sheet.LockedKey"}}" title="{{localize "FATED.Sheet.LockedKey"}}"></i>{{/unless}}</span>
                    <input
                      type="text"
                      name="system.proficiencies.{{index}}.key"
                      value="{{prof.key}}"
                      data-proficiency-key-input="{{prof.key}}"
                      {{#unless @root.canEditProficiencyKeys}}readonly{{/unless}}
                    >
                  </label>
                  <label>
                    <span>{{localize "FATED.Sheet.Attribute"}}</span>
                    <select name="system.proficiencies.{{index}}.attribute" {{disabled (not @root.editable)}}>
                      <option value="heart" {{#if (eq prof.attribute "heart")}}selected{{/if}}>{{localize "FATED.Attribute.Heart"}}</option>
                      <option value="body" {{#if (eq prof.attribute "body")}}selected{{/if}}>{{localize "FATED.Attribute.Body"}}</option>
                      <option value="mind" {{#if (eq prof.attribute "mind")}}selected{{/if}}>{{localize "FATED.Attribute.Mind"}}</option>
                    </select>
                  </label>
                  <label>
                    <span>{{localize "FATED.Sheet.Level"}}</span>
                    <input type="number" name="system.proficiencies.{{index}}.level" value="{{prof.level}}" min="0" {{disabled (not @root.editable)}} />
                  </label>
                  <button type="button" data-action="removeProficiency" data-proficiency-key="{{prof.key}}" {{disabled (not @root.editable)}}>{{localize "FATED.Sheet.Remove"}}</button>
                </div>
              </details>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="muted">{{localize "FATED.Sheet.NoProficiencies"}}</p>
      {{/if}}
      <button type="button" data-action="addProficiency" {{disabled (not editable)}}>{{localize "FATED.Common.AddProficiency"}}</button>
    </div>
  </section>

  {{> "systems/fated/templates/actor/health-state.hbs"}}
  <button type="button" class="fated-character-rest" data-action="openRest">{{localize "FATED.Sheet.Rest"}}</button>

  <section class="panel manual-modifiers">
    <h2>{{localize "FATED.Roll.ManualModifiers"}}</h2>
    {{#each manualModifiers}}
    <div class="manual-modifier-row">
      <label>{{localize "FATED.Roll.Source"}}<input type="text" data-modifier-field="label" data-modifier-id="{{id}}" value="{{label}}" {{disabled (not @root.editable)}}></label>
      <label>{{localize "FATED.Roll.Type"}}<select data-modifier-field="type" data-modifier-id="{{id}}" {{disabled (not @root.editable)}}>
        <option value="successDice" {{#if (eq type "successDice")}}selected{{/if}}>{{localize "FATED.Roll.SuccessDice"}}</option>
        <option value="successThreshold" {{#if (eq type "successThreshold")}}selected{{/if}}>{{localize "FATED.Roll.SuccessThreshold"}}</option>
      </select></label>
      <label>{{localize "FATED.Roll.Value"}}<input type="text" inputmode="text" data-modifier-field="value" data-modifier-id="{{id}}" value="{{signedValue}}" pattern="[+-]?[0-9]+" {{disabled (not @root.editable)}}></label>
      <button type="button" data-action="manualModifier" data-operation="remove" data-modifier-id="{{id}}" {{disabled (not @root.editable)}}>{{localize "FATED.Sheet.Remove"}}</button>
    </div>
    {{/each}}
    <button type="button" data-action="manualModifier" data-operation="add" {{disabled (not editable)}}>{{localize "FATED.Roll.AddModifier"}}</button>
  </section>
  <section class="panel roll-summary">
    <h2>{{localize "FATED.Roll.Summary"}}</h2>
    <div class="roll-summary-grid">
      <div><h3>{{localize "FATED.Roll.SuccessDice"}}</h3>
        <p>{{localize "FATED.Roll.GlobalModifier"}}: <strong>{{rollSummary.diceModifier}}</strong></p>
        <ul>{{#each rollSummary.successDice}}<li>{{label}} <strong>{{signedValue}}</strong></li>{{/each}}</ul>
      </div>
      <div><h3>{{localize "FATED.Roll.SuccessThreshold"}}</h3>
        <p>{{localize "FATED.Roll.Base"}}: {{rollSummary.thresholdBase}}</p>
        <ul>{{#each rollSummary.successThreshold}}<li>{{label}} <strong>{{signedValue}}</strong></li>{{/each}}</ul>
        <p>{{localize "FATED.Roll.FinalGlobalThreshold"}}: <strong>{{rollSummary.thresholdTotal}}+</strong></p>
      </div>
    </div>
  </section>

  {{> "systems/fated/templates/actor/defense.hbs"}}
  {{#if isGM}}<button type="button" data-action="openDamage">{{localize "FATED.Common.PhysicalDamage"}}</button>{{/if}}
  {{/if}}
</div>
