<div class="fated-sheet-body">
  <button type="button" data-action="openMobile">Open mobile interface</button>
  <button type="button" data-action="openRest">Rest</button>
  <header class="fated-sheet-header">
    <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}">
    <div class="identity">
      <label>Name</label>
      <input type="text" name="name" value="{{actor.name}}" {{disabled (not editable)}}>
      <span class="actor-type">Fated</span>
    </div>
  </header>

  <section class="panel">
    <h2>Primary Attributes</h2>
    <div class="stat-grid three">
      <label>Heart <input type="number" name="system.attributes.heart" value="{{system.attributes.heart}}" min="0" {{disabled (not editable)}}></label>
      <label>Body <input type="number" name="system.attributes.body" value="{{system.attributes.body}}" min="0" {{disabled (not editable)}}></label>
      <label>Mind <input type="number" name="system.attributes.mind" value="{{system.attributes.mind}}" min="0" {{disabled (not editable)}}></label>
    </div>
  </section>

  <section class="panel">
  <h2>Skills</h2>

  <div class="skills-grid">
    {{#each skills as |group|}}
      <div class="skill-group">
        <h3>{{group.label}}</h3>

        {{#each group.skills as |skill|}}
          <label>
            {{skill.label}}
            <input
              type="number"
              name="system.skills.{{skill.key}}"
              value="{{skill.value}}"
              min="0"
              step="1"
              {{disabled (not @root.editable)}}
            >
          </label>
        {{/each}}
      </div>
    {{/each}}
  </div>
</section>

  <section class="panel">
    <h2>Resources</h2>
    <div class="resource-grid">
      <label>Endurance
        <span class="resource-pair">
          <input type="number" name="system.resources.endurance.value" value="{{system.resources.endurance.value}}" min="0" max="{{system.resources.endurance.max}}" {{disabled (not editable)}}>
          <strong>/ {{system.resources.endurance.max}}</strong>
        </span>
      </label>
      <label>Hope
        <span class="resource-pair">
          <input type="number" name="system.resources.hope.value" value="{{system.resources.hope.value}}" min="-{{system.resources.hope.max}}" max="{{system.resources.hope.max}}" {{disabled (not editable)}}>
          <strong>± {{system.resources.hope.max}}</strong>
        </span>
      </label>
      <label>Power <input type="number" name="system.resources.power" value="{{system.resources.power}}" min="0" {{disabled (not editable)}}></label>
      <label>Load <input type="number" value="{{system.load}}" readonly></label>
      <label>Current Stance <select name="system.currentStance" {{disabled (not editable)}}>{{#each currentStances}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div>
  </section>

  <section class="panel">
    <h2>Proficiencies</h2>
    <div class="proficiencies-grid">
      {{#if system.proficiencies.length}}
        <ul class="proficiency-list">
          {{#each system.proficiencies as |prof index|}}
            <li class="proficiency-row" data-proficiency-key="{{prof.key}}">
              <label>
                <span>Display</span>
                <input type="text" name="system.proficiencies.{{index}}.displayName" value="{{prof.displayName}}" {{disabled (not @root.editable)}} />
              </label>
              <label>
                <span>Key</span>
                <input
                  type="text"
                  name="system.proficiencies.{{index}}.key"
                  value="{{prof.key}}"
                  readonly
                >
              </label>
              <label>
                <span>Attribute</span>
                <select name="system.proficiencies.{{index}}.attribute" {{disabled (not @root.editable)}}>
                  <option value="heart" {{#if (eq prof.attribute "heart")}}selected{{/if}}>Heart</option>
                  <option value="body" {{#if (eq prof.attribute "body")}}selected{{/if}}>Body</option>
                  <option value="mind" {{#if (eq prof.attribute "mind")}}selected{{/if}}>Mind</option>
                </select>
              </label>
              <label>
                <span>Level</span>
                <input type="number" name="system.proficiencies.{{index}}.level" value="{{prof.level}}" min="0" {{disabled (not @root.editable)}} />
              </label>
              <button type="button" data-action="removeProficiency" data-proficiency-key="{{prof.key}}" {{disabled (not @root.editable)}}>Remove</button>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="muted">No proficiencies yet.</p>
      {{/if}}
      <button type="button" data-action="addProficiency" {{disabled (not editable)}}>Add Proficiency</button>
    </div>
  </section>

  {{> "systems/fated/templates/actor/health-state.hbs"}}
  {{> "systems/fated/templates/actor/defense.hbs"}}
  {{#if isGM}}<button type="button" data-action="openDamage">Physical damage bookkeeping</button>{{/if}}

  <section class="panel inventory">
    <h2>Items</h2>
    {{#if items.length}}
      <ul class="item-list">
        {{#each items as |item|}}
          <li class="item-row draggable" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="">
            <span>{{item.name}}</span>
            <small>{{item.type}}</small>
            {{#if item.equipmentState}}<button type="button" data-action="toggleEquipment" data-item-id="{{item.id}}" aria-pressed="{{item.equipped}}" {{disabled (not item.editable)}}>{{item.stateLabel}}: {{#if item.equipped}}Yes{{else}}No{{/if}}</button>{{/if}}
            <button type="button" data-action="removeItem" data-item-id="{{item.id}}" {{disabled (not @root.editable)}}>Remove</button>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="muted">No items yet.</p>
    {{/if}}
  </section>

  <section class="panel biography">
    <h2>Biography / Notes</h2>
    <textarea name="system.biography" rows="8" {{disabled (not editable)}}>{{system.biography}}</textarea>
  </section>
</div>
