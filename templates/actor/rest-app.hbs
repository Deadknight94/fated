<div class="rest-content">
  <h1>{{localize "FATED.Common.Rest"}} · {{actor.name}}</h1>
  <section class="rest-resources">
    <p>{{localize "FATED.Resource.Endurance"}}: {{endurance.current}} / {{endurance.max}}</p>
    <p>{{localize "FATED.Resource.Hope"}}: {{hope.current}} / ±{{hope.limit}}</p>
    <p>{{localize "FATED.Resource.Power"}}: {{power.current}} / {{power.max}}</p>
    <p>{{wound.woundLabel}} · {{localize "FATED.Rest.Care"}}: {{careLabel}} · {{localize "FATED.Rest.DaysRemaining"}}: {{woundCare.daysRemaining}}</p>
  </section>
  <section><h2>{{localize "FATED.Rest.Short"}}</h2><p>{{localize "FATED.Rest.ShortHint"}}</p>
    <fieldset {{disabled (not editable)}}>
      <label><input type="checkbox" data-rest-field="spendHope" {{checked spendHope}}> {{localize "FATED.Rest.SpendHope"}}</label>
      {{#if spendHope}}<label>{{localize "FATED.Rest.ExtraEndurance"}} <select data-rest-field="extraRecovery">{{#each extraChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}
      <label>{{localize "FATED.Rest.ShortHealing"}} <input type="number" step="1" data-rest-field="shortHealing" value="{{values.shortHealing}}" inputmode="numeric"></label>
      <button type="button" data-action="shortRest">{{localize "FATED.Rest.ExecuteShort"}}</button>
    </fieldset>
  </section>
  <section><h2>{{localize "FATED.Rest.Long"}}</h2><p>{{localize "FATED.Rest.LongHint"}}</p>
    <fieldset {{disabled (not editable)}}>
      <label>{{localize "FATED.Rest.LongHealing"}} <input type="number" step="1" data-rest-field="longHealing" value="{{values.longHealing}}" inputmode="numeric"></label>
      <button type="button" data-action="longRest">{{localize "FATED.Rest.ExecuteLong"}}</button>
    </fieldset>
  </section>
  <section><h2>{{localize "FATED.Rest.Extended"}}</h2><p>{{localize "FATED.Rest.ExtendedHint"}}</p>
    <fieldset {{disabled (not editable)}}>
      <p>{{localize "FATED.Rest.BeginHint"}}</p>
      <button type="button" data-action="beginExtended">{{localize "FATED.Rest.Begin"}}</button>
      <p>{{localize "FATED.Rest.DayHint"}}</p>
      <label>{{localize "FATED.Rest.ExtendedHealing"}} <input type="number" step="1" data-rest-field="extendedHealing" value="{{values.extendedHealing}}" inputmode="numeric"></label>
      <button type="button" data-action="completeExtendedDay">{{localize "FATED.Rest.CompleteDay"}}</button>
      <p>{{localize "FATED.Rest.CareDayHint"}}</p>
      <button type="button" data-action="advanceCareDay">{{localize "FATED.Rest.AdvanceCare"}}</button>
      <p>{{localize "FATED.Rest.PendingHint"}}</p>
      <button type="button" data-action="completeGrievousHealing" {{disabled (not canCompletePending)}}>{{localize "FATED.Rest.CompleteHealing"}}</button>
    </fieldset>
  </section>
</div>
