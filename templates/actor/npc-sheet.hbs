<div class="fated-sheet-body">
  <header class="fated-sheet-header">
    <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
    <div class="identity">
      <label>{{localize "FATED.Sheet.Name"}}</label>
      <input type="text" name="name" value="{{actor.name}}" {{disabled (not editable)}}>
      <span class="actor-type">{{localize "FATED.Npc.Type"}}</span>
    </div>
  </header>

  <nav class="npc-navigation">
    {{#each npcSections}}
      <button type="button" data-action="selectNpcSection" data-section="{{id}}" aria-pressed="{{active}}">{{label}}</button>
    {{/each}}
  </nav>
  <div class="npc-content">
  {{#if npcStats}}
  <section class="panel">
    <h2>{{localize "FATED.Npc.Stats"}}</h2>
    <h3>{{localize "FATED.Sheet.PrimaryAttributes"}}</h3>
    <div class="stat-grid three">
      <label>{{localize "FATED.Attribute.Heart"}} <input type="number" name="system.attributes.heart" value="{{system.attributes.heart}}" min="0" step="1" {{disabled (not editable)}}></label>
      <label>{{localize "FATED.Attribute.Body"}} <input type="number" name="system.attributes.body" value="{{system.attributes.body}}" min="0" step="1" {{disabled (not editable)}}></label>
      <label>{{localize "FATED.Attribute.Mind"}} <input type="number" name="system.attributes.mind" value="{{system.attributes.mind}}" min="0" step="1" {{disabled (not editable)}}></label>
    </div>
    <div class="resource-grid">
      <label>{{localize "FATED.Resource.Resilience"}}
        <span class="resource-pair">
          <input type="number" name="system.resilience.value" value="{{system.resilience.value}}" min="0" max="{{system.resilience.max}}" {{disabled (not editable)}}>
          <span>/</span>
          <input type="number" name="system.resilience.max" value="{{system.resilience.max}}" min="0" {{disabled (not editable)}}>
        </span>
      </label>
      <label>{{localize "FATED.Combat.Defense"}} <input type="number" name="system.defense" value="{{system.defense}}" min="0" {{disabled (not editable)}}></label>
    </div>
  </section>

  {{/if}}
  {{#if npcActions}}
  <section class="panel npc-actions">
    {{#each actions}}
      <article class="npc-action">
        <h3>{{name}}</h3>
        <button type="button" data-action="openNpcItem" data-item-id="{{source.itemId}}">{{source.itemName}}</button>
        <dl>
          <dt>{{localize "FATED.Action.Classification"}}</dt><dd>{{classificationLabel}}</dd>
          {{#if attackLabel}}<dt>{{localize "FATED.Item.AttackType"}}</dt><dd>{{attackLabel}}</dd>{{/if}}
          {{#if rangeLabel}}<dt>{{localize "FATED.Action.Range"}}</dt><dd>{{rangeLabel}}</dd>{{/if}}
          <dt>{{localize "FATED.Action.RollRequirement"}}</dt><dd>{{rollLabel}}</dd>
        </dl>
        {{#if effect}}<p class="npc-rules">{{effect}}</p>{{/if}}
        {{#if rules}}<p class="npc-rules">{{rules}}</p>{{/if}}
      </article>
    {{else}}
      <p class="muted">{{localize "FATED.Item.NoActions"}}</p>
    {{/each}}
  </section>
  {{/if}}
  {{#if npcItems}}
  <section class="panel inventory">
    <h2>{{localize "FATED.Sheet.Items"}}</h2>
    {{#if items.length}}
      <ul class="item-list">
        {{#each items as |item|}}
          <li class="item-row draggable" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="">
            <button type="button" data-action="openNpcItem" data-item-id="{{item.id}}">{{item.name}}</button>
            <small>{{item.typeLabel}}</small>
            {{#if @root.editable}}
              <button type="button" data-action="removeItem" data-item-id="{{item.id}}">{{localize "FATED.Sheet.Remove"}}</button>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="muted">{{localize "FATED.Sheet.NoItems"}}</p>
    {{/if}}
  </section>

  {{/if}}
  {{#if npcNotes}}
  <section class="panel">
    <h2>{{localize "FATED.Npc.Notes"}}</h2>
    <textarea name="system.description" rows="10" {{disabled (not editable)}}>{{system.description}}</textarea>
  </section>
  {{/if}}
  </div>
</div>
